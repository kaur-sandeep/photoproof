MODERATION_HOST=127.0.0.1
MODERATION_PORT=8001
WEAPON_THRESHOLD=0.80
NSFW_THRESHOLD=0.80
VIOLENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE_MB=15

# These paths must point to files/directories already present on this server.
WEAPON_MODEL_PATH=models/weapons.pt
# Set labels only after inspecting the local model's labels. Comma-separated exact labels.
WEAPON_LABELS=
# Optional local Hugging Face image-classification model directories. Never model IDs.
NSFW_MODEL_PATH=
NSFW_LABELS=nsfw,porn,sexy,hentai
VIOLENCE_MODEL_PATH=
VIOLENCE_LABELS=violence,gore,graphic violence
